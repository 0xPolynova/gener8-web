# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-secret

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Solana ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GENER8_TOKEN_MINT=
GENER8_TOKEN_DECIMALS=9

# Public (safe) token metadata for UI
NEXT_PUBLIC_GENER8_TOKEN_MINT=
NEXT_PUBLIC_GENER8_TOKEN_SYMBOL=GENER8

# Optional marketplace / DEX URL for the "Get GENER8" CTA
NEXT_PUBLIC_GET_GENER8_URL=

# ─── Token gating (server-enforced; UI reads public mirrors) ─────────────────
GENER8_MIN_BALANCE=10000
GENER8_DAILY_GENERATIONS=5
NEXT_PUBLIC_GENER8_MIN_BALANCE=10000

# ─── AI video providers ──────────────────────────────────────────────────────
# Presets (Hotel Lobby) use WaveSpeed Wan 3.0. Custom tiers use OpenRouter.
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_MODEL_REF=alibaba/wan-3.0/reference-to-video
FAL_KEY=
FAL_MODEL_T2V=bytedance/seedance-2.5/text-to-video
FAL_MODEL_REF=fal-ai/kling-video/o1/video-to-video/edit
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=bytedance/seedance-2.0-fast
OPENROUTER_MODEL_PRO=bytedance/seedance-2.0
OPENROUTER_MODEL_CINEMATIC=alibaba/wan-3.0
VIDEO_PROVIDER=fal
VIDEO_PROVIDER_WEBHOOK_SECRET=

# ─── Storage / CDN (Cloudflare Images) ───────────────────────────────────────
# Delivery: https://imagedelivery.net/<account_hash>/<image_id>/<variant>
NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH=evSvvg4gSrZmei5DvWV8Aw
NEXT_PUBLIC_CF_IMAGES_VARIANT=public
CDN_BASE_URL=https://imagedelivery.net/evSvvg4gSrZmei5DvWV8Aw
STORAGE_BUCKET=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Demo mode (used only when on-chain RPC / mint are not configured) ──────
# Grants a mock GENER8 balance so the full product can be exercised locally.
DEMO_MODE=true
DEMO_TOKEN_BALANCE=25000
